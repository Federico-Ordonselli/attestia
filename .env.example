# Valori di SOLO SVILUPPO, palesemente finti. Copiare in .env (ignorato da git): cp .env.example .env
# Non riutilizzare mai questi valori fuori dalla macchina di sviluppo.

# SQL Server 2022 in Docker
MSSQL_SA_PASSWORD=Dev_Only_Not_A_Secret_1!
ConnectionStrings__Attestia='Server=localhost,1433;Database=Attestia;User ID=sa;Password=Dev_Only_Not_A_Secret_1!;TrustServerCertificate=True;Encrypt=True'

# Keycloak (IdP SAML di sviluppo) - console admin su http://localhost:8081
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-only-kcadmin

# Chiave HMAC del cookie attestia_sso: base64 di almeno 32 byte, condivisa con il portale ASP classic.
# Questo valore e' il base64 di "DEV-ONLY-NOT-A-SECRET-attestia-sso-key!!" (40 byte). Generane una vera con:
#   openssl rand -base64 48
ATTESTIA_SSO_KEY=REVWLU9OTFktTk9ULUEtU0VDUkVULWF0dGVzdGlhLXNzby1rZXkhIQ==
