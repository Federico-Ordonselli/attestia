{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Saml": {
    "EntityId": "urn:attestia:sp",
    "SessionMinutes": 60
  },
  "RateLimits": {
    "UploadsPerMinute": 5
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
