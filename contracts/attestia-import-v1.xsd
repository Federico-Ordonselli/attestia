<?xml version="1.0" encoding="utf-8"?>
<!--
  Attestia - contratto di import dei completamenti (versione 1).
  Esportato da un LMS; ogni <completion> e' un corso completato da un dipendente.
  Il namespace contiene la versione: una modifica non retrocompatibile richiede urn:attestia:import:v2.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:attestia:import:v1"
           targetNamespace="urn:attestia:import:v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <xs:simpleType name="Code">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9\-]{2,20}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Score">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="100"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Data di calendario senza fuso orario (xs:date accetterebbe anche "2026-01-31+01:00"). -->
  <xs:simpleType name="CalendarDate">
    <xs:restriction base="xs:date">
      <xs:pattern value="\d{4}-\d{2}-\d{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ExportId">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="64"/>
      <xs:pattern value="[A-Za-z0-9._:\-]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Completion">
    <xs:sequence>
      <xs:element name="employeeNumber" type="Code"/>
      <xs:element name="courseCode" type="Code"/>
      <xs:element name="completedOn" type="CalendarDate"/>
      <xs:element name="score" type="Score" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="completions">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="completion" type="Completion" minOccurs="1" maxOccurs="5000"/>
      </xs:sequence>
      <xs:attribute name="exportId" type="ExportId" use="required"/>
      <xs:attribute name="generatedAt" type="xs:dateTime" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
