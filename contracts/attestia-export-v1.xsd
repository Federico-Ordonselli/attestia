<?xml version="1.0" encoding="utf-8"?>
<!-- Attestia - export delle scadenze (versione 1). Stesso stile di namespace/versione dell'import. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:attestia:export:v1"
           targetNamespace="urn:attestia:export:v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <xs:simpleType name="Code">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9\-]{2,20}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CalendarDate">
    <xs:restriction base="xs:date">
      <xs:pattern value="\d{4}-\d{2}-\d{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Status">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Valid"/>
      <xs:enumeration value="ExpiringSoon"/>
      <xs:enumeration value="Expired"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Expiration">
    <xs:sequence>
      <xs:element name="employeeNumber" type="Code"/>
      <xs:element name="lastName" type="xs:string"/>
      <xs:element name="firstName" type="xs:string"/>
      <xs:element name="department" type="xs:string"/>
      <xs:element name="courseCode" type="Code"/>
      <xs:element name="courseTitle" type="xs:string"/>
      <xs:element name="completedOn" type="CalendarDate"/>
      <xs:element name="expiresOn" type="CalendarDate"/>
      <xs:element name="daysToExpiry" type="xs:int"/>
      <xs:element name="status" type="Status"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="expirations">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="expiration" type="Expiration" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="generatedAt" type="xs:dateTime" use="required"/>
      <xs:attribute name="asOf" type="CalendarDate" use="required"/>
      <xs:attribute name="withinDays" type="xs:int" use="required"/>
      <xs:attribute name="department" type="xs:string" use="optional"/>
      <xs:attribute name="count" type="xs:int" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
